APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
# Local mode preserves the desktop workflow. Remote access requires hosted mode.
APP_MODE=local
APP_ALLOW_REMOTE_HUMAN=false
# Hosted mode also requires APP_PUBLIC_URL=https://your-domain and a hash secret:
# APP_PASSWORD_HASH_FILE=/run/secrets/tracker_password_hash
# APP_SESSION_HOURS=8
# APP_TRUSTED_PROXY_IPS=127.0.0.1
# Optional phone notifications require HTTPS hosted mode and a persistent VAPID key:
# APP_PUSH_VAPID_KEY_FILE=/run/secrets/tracker_vapid_key
# APP_PUSH_CONTACT=mailto:admin@example.com
APP_DATA_DIR=./data
APP_STATIC_DIR=./frontend/dist
LOG_LEVEL=info
# Optional single Google connection; exact callback origin must match APP_HOST/PORT
# (or APP_PUBLIC_URL in hosted mode). Keep the real secret out of source control.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret-if-required
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/connections/google/callback
FOLLOWUP_DELAY_DAYS=7
MAX_FOLLOWUP_SUGGESTIONS=2
POSTING_PLAYWRIGHT_FALLBACK=true

# PrimeUI Community/Commercial license key (keep the real key in .env).
VITE_PRIMEUI_LICENSE_KEY=

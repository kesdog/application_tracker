# Public DNS name only; do not include https:// or a path.
TRACKER_DOMAIN=tracker.example.com
# Optional Google overlay (compose.google.yaml). Keep real credentials in this ignored file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reserved public phone-origin configuration; phone implementation requires live acceptance first.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_ORIGIN=
# For the optional compose.push.yaml overlay:
# TRACKER_PUSH_CONTACT=mailto:admin@example.com
